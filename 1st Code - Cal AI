<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cal AI Hybrid · Víctor (Nutrición y Entrenamiento Híbrido)</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            brand: {
              lime: '#B6FF2B',
              emerald: '#10B981',
              cyan: '#06B6D4',
              amber: '#F59E0B',
              rose: '#F43F5E',
              dark: '#0B0F17',
              card: '#131A26',
              border: '#222D40'
            }
          }
        }
      }
    };
  </script>
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #0B0F17;
      color: #F3F4F6;
      overflow-x: hidden;
    }
    .glass-card {
      background: rgba(19, 26, 38, 0.88);
      backdrop-filter: blur(12px);
      border: 1px solid #222D40;
    }
    .scan-line {
      position: absolute;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, transparent, #B6FF2B, transparent);
      box-shadow: 0 0 12px #B6FF2B;
      animation: scanMove 2.2s infinite ease-in-out;
    }
    @keyframes scanMove {
      0% { top: 6%; opacity: 0.9; }
      50% { top: 92%; opacity: 1; }
      100% { top: 6%; opacity: 0.9; }
    }
    .ring-transition {
      transition: stroke-dashoffset 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0B0F17;
    }
    ::-webkit-scrollbar-thumb {
      background: #222D40;
      border-radius: 9999px;
    }
  </style>
</head>
<body class="min-h-screen bg-[#0B0F17] text-slate-100 pb-24">

  <!-- Top Hero & Navigation Bar -->
  <header class="relative border-b border-slate-800/80 bg-[#0F1521]/95 sticky top-0 z-30 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-[#B6FF2B] text-slate-950 flex items-center justify-center font-extrabold text-lg shadow-lg shadow-[#B6FF2B]/20">
          CA
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="font-extrabold text-lg tracking-tight text-white">Cal AI <span class="text-[#B6FF2B] font-semibold">Hybrid</span></h1>
            <span class="text-[11px] uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 font-semibold">
              Víctor · 21 años
            </span>
          </div>
          <p class="text-xs text-slate-400">Nutrición Fotográfica + Mesociclo Híbrido & Protección LCA/Menisco Derecho</p>
        </div>
      </div>

      <!-- Main Navigation Tabs -->
      <nav class="flex items-center gap-1 bg-slate-900/90 p-1 rounded-xl border border-slate-800 overflow-x-auto max-w-full" aria-label="Navegación principal">
        <button type="button" data-tab="scanner" class="nav-tab-btn px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all bg-[#B6FF2B] text-slate-950">
          📸 Cal AI Hoy
        </button>
        <button type="button" data-tab="training" class="nav-tab-btn px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all text-slate-300 hover:text-white">
          🏃‍♂️ Plan Híbrido (Mes)
        </button>
        <button type="button" data-tab="analytics" class="nav-tab-btn px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all text-slate-300 hover:text-white">
          📊 Gráficos y Parámetros
        </button>
        <button type="button" data-tab="academy" class="nav-tab-btn px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all text-slate-300 hover:text-white">
          🎓 Escuela Híbrida
        </button>
      </nav>

      <!-- Profile Calibration Button -->
      <button type="button" id="openProfileModalBtn" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-semibold text-slate-200 flex items-center gap-1.5 transition">
        <span>⚙️ Calibrar Perfil</span>
        <span id="profileSummaryBadge" class="text-[#B6FF2B] font-bold">72kg · 174cm</span>
      </button>
    </div>
  </header>

  <!-- Main Content Container -->
  <main class="max-w-6xl mx-auto px-4 pt-5 space-y-6">

    <!-- Compact Clinical & Athletic Context Banner -->
    <section class="relative rounded-2xl overflow-hidden border border-slate-800 shadow-xl">
      <img src="data:image/jpeg;base64," alt="Entrenamiento Híbrido" class="w-full h-36 sm:h-44 object-cover opacity-35" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#0B0F17] via-[#0B0F17]/85 to-transparent flex flex-col justify-center p-4 sm:p-6">
        <div class="flex flex-wrap items-center gap-2 mb-1.5">
          <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-[#B6FF2B]/20 text-[#B6FF2B] border border-[#B6FF2B]/40">
            MODO RETORNO DEPORTIVO + RECOMPOSICIÓN
          </span>
          <span id="kneeStatusPill" class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">
            🦵 Rodilla Der. (Injerto LCA + Sutura Asa de Balde): Carga Controlada
          </span>
        </div>
        <h2 class="text-base sm:text-xl font-extrabold text-white max-w-2xl">
          Hola Víctor: tu combustible diario se ajusta automáticamente a tu entrenamiento híbrido.
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 max-w-2xl mt-0.5">
          Venimos de 3-4 semanas mejorando calidad nutricional y reduciendo calorías. Evitaremos déficits agresivos (&gt;400 kcal) para proteger tu masa muscular, el injerto de LCA y tu sutura meniscal.
        </p>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- TAB 1: CAL AI HOY (RINGS + PHOTO SCANNER)  -->
    <!-- ========================================== -->
    <section id="tab-scanner" class="tab-panel space-y-6">

      <!-- Top Row: Cal AI Main Ring + Macros + Knee & Collagen Protocol -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">

        <!-- Left 7 cols: Cal AI Summary Card -->
        <div class="lg:col-span-7 glass-card rounded-2xl p-5 flex flex-col justify-between">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800/80 pb-3 mb-4">
            <div>
              <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Balance Energético de Hoy</span>
              <h3 class="text-lg font-bold text-white flex items-center gap-2">
                Panel Cal AI
                <span id="activeTrainingDayBadge" class="text-xs font-medium px-2.5 py-0.5 rounded-full bg-slate-800 text-[#B6FF2B]">
                  Día 1 · Natación + Estabilidad LCA
                </span>
              </h3>
            </div>
            <div class="flex items-center gap-2">
              <label for="daySelectorQuick" class="text-xs text-slate-400">Día del mes:</label>
              <select id="daySelectorQuick" class="bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1 text-xs text-white font-semibold focus:outline-none focus:border-[#B6FF2B]">
                <!-- Populated by JS -->
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-center">
            <!-- Big Circular Ring -->
            <div class="sm:col-span-5 flex flex-col items-center justify-center relative">
              <svg class="w-44 h-44 -rotate-90" viewBox="0 0 160 160">
                <circle cx="80" cy="80" r="66" stroke="#1E293B" stroke-width="12" fill="transparent" />
                <circle id="mainCalorieRing" cx="80" cy="80" r="66" stroke="#B6FF2B" stroke-width="12" stroke-linecap="round" fill="transparent" stroke-dasharray="414.69" stroke-dashoffset="150" class="ring-transition" />
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                <span id="caloriesRemainingText" class="text-3xl font-extrabold text-white">890</span>
                <span id="caloriesRemainingLabel" class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">kcal restantes</span>
                <span id="caloriesConsumedSub" class="text-xs text-[#B6FF2B] font-semibold mt-1">1,560 / 2,450 kcal</span>
              </div>
            </div>

            <!-- Macro Breakdown Bars -->
            <div class="sm:col-span-7 space-y-4">
              <!-- Protein -->
              <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800/90">
                <div class="flex justify-between text-xs font-semibold mb-1">
                  <span class="text-rose-400 flex items-center gap-1.5">🥩 Proteína (Síntesis & Injerto)</span>
                  <span id="proteinText" class="text-white">118g / 158g</span>
                </div>
                <div class="w-full h-2.5 bg-slate-800 rounded-full overflow-hidden">
                  <div id="proteinBar" class="h-full bg-rose-500 rounded-full transition-all duration-500" style="width: 75%"></div>
                </div>
                <p class="text-[11px] text-slate-400 mt-1">Meta: 2.2 g/kg para proteger masa muscular y reparar tejido conectivo.</p>
              </div>

              <!-- Carbs -->
              <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800/90">
                <div class="flex justify-between text-xs font-semibold mb-1">
                  <span class="text-cyan-400 flex items-center gap-1.5">⚡ Carbohidratos Complejos (Glucógeno)</span>
                  <span id="carbsText" class="text-white">165g / 265g</span>
                </div>
                <div class="w-full h-2.5 bg-slate-800 rounded-full overflow-hidden">
                  <div id="carbsBar" class="h-full bg-cyan-400 rounded-full transition-all duration-500" style="width: 62%"></div>
                </div>
                <p class="text-[11px] text-slate-400 mt-1">Periodizados según el gasto aeróbico del día (ciclismo/natación/carrera).</p>
              </div>

              <!-- Fats -->
              <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800/90">
                <div class="flex justify-between text-xs font-semibold mb-1">
                  <span class="text-amber-400 flex items-center gap-1.5">🥑 Grasas Saludables (Hormonal & Antiinflamatoria)</span>
                  <span id="fatsText" class="text-white">48g / 68g</span>
                </div>
                <div class="w-full h-2.5 bg-slate-800 rounded-full overflow-hidden">
                  <div id="fatsBar" class="h-full bg-amber-400 rounded-full transition-all duration-500" style="width: 70%"></div>
                </div>
                <p class="text-[11px] text-slate-400 mt-1">Priorizando Omega-3, palta, aceite de oliva y frutos secos.</p>
              </div>
            </div>
          </div>

          <!-- Bottom Mini Stats Bar -->
          <div class="grid grid-cols-3 gap-3 mt-5 pt-4 border-t border-slate-800/80 text-center">
            <div class="bg-slate-900/60 rounded-xl p-2.5 border border-slate-800">
              <span class="text-[11px] text-slate-400 block">Gasto Basal (TMB)</span>
              <span id="tmbStat" class="text-sm font-bold text-white">1,745 kcal</span>
            </div>
            <div class="bg-slate-900/60 rounded-xl p-2.5 border border-slate-800">
              <span class="text-[11px] text-slate-400 block">Quemadas Entreno</span>
              <span id="burnedStat" class="text-sm font-bold text-[#B6FF2B]">+420 kcal</span>
            </div>
            <div class="bg-slate-900/60 rounded-xl p-2.5 border border-slate-800">
              <span class="text-[11px] text-slate-400 block">Ajuste Meta</span>
              <span id="deficitStat" class="text-sm font-bold text-emerald-400">-250 kcal (Recomp)</span>
            </div>
          </div>
        </div>

        <!-- Right 5 cols: Hydration + Joint & Tendon Recovery Tracker -->
        <div class="lg:col-span-5 glass-card rounded-2xl p-5 flex flex-col justify-between space-y-4">
          <div>
            <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Bio-Parámetros Diarios</span>
            <h3 class="text-lg font-bold text-white">Hidratación y Protocolo Articular</h3>
          </div>

          <!-- Water Tracker -->
          <div class="bg-slate-900/80 rounded-xl p-4 border border-slate-800">
            <div class="flex items-center justify-between mb-2">
              <div>
                <h4 class="text-sm font-bold text-cyan-300">💧 Hidratación en Altitud</h4>
                <p class="text-[11px] text-slate-400">Meta sugerida: 3.0 L/día (+500 ml por hora de entreno)</p>
              </div>
              <span id="waterCountText" class="text-base font-extrabold text-white">2.0 / 3.0 L</span>
            </div>
            <div class="w-full h-2.5 bg-slate-800 rounded-full overflow-hidden mb-3">
              <div id="waterBar" class="h-full bg-cyan-400 rounded-full transition-all" style="width: 66%"></div>
            </div>
            <div class="flex items-center gap-2">
              <button type="button" id="subWaterBtn" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 transition">- 250 ml</button>
              <button type="button" id="addWaterBtn" class="flex-1 py-1.5 rounded-lg bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/40 text-xs font-bold text-cyan-300 transition">+ Sumar Vaso (250 ml)</button>
            </div>
          </div>

          <!-- ACL & Meniscus Daily Micro-Habits -->
          <div class="bg-slate-900/80 rounded-xl p-4 border border-slate-800 space-y-2.5">
            <div class="flex items-center justify-between">
              <h4 class="text-sm font-bold text-[#B6FF2B]">🦵 Check-in Rodilla Derecha & Nutrición</h4>
              <span id="habitScoreBadge" class="text-xs font-bold text-emerald-400">2/3 listos</span>
            </div>
            <label class="flex items-start gap-2.5 cursor-pointer text-xs text-slate-200 bg-slate-950/60 p-2.5 rounded-lg border border-slate-800/80">
              <input type="checkbox" class="habit-check mt-0.5 accent-[#B6FF2B]" data-habit="collagen" checked />
              <span><strong>Colágeno (15g) + Vitamina C (50mg):</strong> Tomar 45 min antes de entrenar para síntesis en injerto LCA y menisco.</span>
            </label>
            <label class="flex items-start gap-2.5 cursor-pointer text-xs text-slate-200 bg-slate-950/60 p-2.5 rounded-lg border border-slate-800/80">
              <input type="checkbox" class="habit-check mt-0.5 accent-[#B6FF2B]" data-habit="protein_dist" checked />
              <span><strong>4 tomas de 35-40g de proteína:</strong> Distribución uniforme cada 3-4 horas para maximizar síntesis miofibrilar.</span>
            </label>
            <label class="flex items-start gap-2.5 cursor-pointer text-xs text-slate-200 bg-slate-950/60 p-2.5 rounded-lg border border-slate-800/80">
              <input type="checkbox" class="habit-check mt-0.5 accent-[#B6FF2B]" data-habit="vmo_activation" />
              <span><strong>Activación isométrica VMO (10 min):</strong> Extensión terminal de rodilla con banda antes de ciclismo o carrera.</span>
            </label>
          </div>

          <!-- Knee Sensation Slider -->
          <div class="bg-slate-900/80 rounded-xl p-3.5 border border-slate-800">
            <div class="flex justify-between items-center text-xs mb-1">
              <span class="font-semibold text-slate-300">Molestia/Rigidez Rodilla Derecha Hoy (EVA 0-10):</span>
              <span id="kneePainValueLabel" class="font-bold text-emerald-400">1 / 10 (Óptima)</span>
            </div>
            <input type="range" id="kneePainSlider" min="0" max="10" value="1" class="w-full accent-[#B6FF2B] cursor-pointer" />
            <p id="kneeClinicalAdvice" class="text-[11px] text-slate-400 mt-1">
              ✅ Verde (0-2/10): Puedes ejecutar la sesión planificada sin restricciones adicionales.
            </p>
          </div>
        </div>
      </div>

      <!-- Second Row: Cal AI Photo Scanner + Today's Meal Log -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">

        <!-- Left 6 cols: Cal AI Visual Photo Scanner -->
        <div class="lg:col-span-6 glass-card rounded-2xl p-5 space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <span class="text-xs uppercase tracking-wider text-[#B6FF2B] font-bold">Visión Nutricional</span>
              <h3 class="text-lg font-bold text-white">📸 Escáner Fotográfico Cal AI</h3>
            </div>
            <label for="mealPhotoInput" class="cursor-pointer px-3.5 py-2 rounded-xl bg-[#B6FF2B] hover:bg-[#a3eb1b] text-slate-950 font-bold text-xs flex items-center gap-1.5 shadow-md transition">
              <span>Subir / Tomar Foto</span>
              <input type="file" id="mealPhotoInput" accept="image/*" class="hidden" />
            </label>
          </div>

          <p class="text-xs text-slate-400">
            Sube una foto de tu plato o prueba nuestros platos modelo. Cal AI detecta los grupos de alimentos, estima gramos y calcula macros al instante.
          </p>

          <!-- Preset Meal Selector Buttons -->
          <div class="flex flex-wrap gap-1.5">
            <button type="button" data-preset="chicken_quinoa" class="preset-meal-btn px-2.5 py-1 rounded-lg text-xs font-semibold bg-[#B6FF2B]/20 text-[#B6FF2B] border border-[#B6FF2B]/40 transition">
              🥗 Bowl Pollo, Quinua y Palta
            </button>
            <button type="button" data-preset="oats_eggs" class="preset-meal-btn px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 hover:text-white border border-slate-700 transition">
              🍳 Avena Proteica + 3 Huevos
            </button>
            <button type="button" data-preset="trout_sweetpotato" class="preset-meal-btn px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 hover:text-white border border-slate-700 transition">
              🐟 Trucha a la Plancha + Camote
            </button>
            <button type="button" data-preset="recovery_shake" class="preset-meal-btn px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 hover:text-white border border-slate-700 transition">
              🥤 Batido Post-Entreno + Colágeno
            </button>
          </div>

          <!-- Scanner Viewport with AI Bounding Boxes -->
          <div class="relative rounded-2xl overflow-hidden border border-slate-700 bg-slate-950 aspect-[4/3] max-h-72 mx-auto flex items-center justify-center">
            <img id="scannerPreviewImg" src="data:image/jpeg;base64," alt="Vista previa del plato" class="w-full h-full object-cover" />
            <div id="scannerLaser" class="scan-line"></div>

            <!-- Interactive Bounding Box Tags Overlaid -->
            <div id="scannerOverlays" class="absolute inset-0 pointer-events-none p-3 flex flex-col justify-between">
              <!-- Populated dynamically by JS -->
            </div>
          </div>

          <!-- Detected Meal Controls & Portion Multiplier -->
          <div class="bg-slate-900/90 rounded-xl p-4 border border-slate-800 space-y-3">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <input type="text" id="scannedMealTitle" value="Bowl de Pollo Grillado, Quinua, Camote y Palta" class="bg-transparent border-b border-slate-700 focus:border-[#B6FF2B] text-sm font-bold text-white focus:outline-none w-64 sm:w-80" />
                <span id="scanConfidenceBadge" class="block text-[11px] text-emerald-400 font-medium mt-0.5">
                  ✓ Densidad nutricional alta · Índice inflamatorio bajo
                </span>
              </div>
              <div class="text-right">
                <span id="scannedTotalKcal" class="text-xl font-extrabold text-[#B6FF2B]">640 kcal</span>
                <span class="block text-[10px] uppercase text-slate-400">Estimación Cal AI</span>
              </div>
            </div>

            <!-- Portion Multiplier Slider -->
            <div>
              <div class="flex justify-between text-xs mb-1">
                <span class="text-slate-400">Ajustar tamaño de la porción:</span>
                <span id="portionMultiplierLabel" class="font-bold text-white">1.0x (Estándar · 480g)</span>
              </div>
              <input type="range" id="portionMultiplierSlider" min="0.5" max="2.0" step="0.1" value="1.0" class="w-full accent-[#B6FF2B] cursor-pointer" />
            </div>

            <!-- Editable Macro Pills -->
            <div class="grid grid-cols-3 gap-2 pt-1">
              <div class="bg-slate-950 p-2 rounded-lg border border-slate-800 text-center">
                <label for="scanProtInput" class="text-[10px] text-rose-400 uppercase font-bold block">Proteína (g)</label>
                <input type="number" id="scanProtInput" value="48" min="0" max="250" class="w-full bg-transparent text-center font-extrabold text-sm text-white focus:outline-none" />
              </div>
              <div class="bg-slate-950 p-2 rounded-lg border border-slate-800 text-center">
                <label for="scanCarbInput" class="text-[10px] text-cyan-400 uppercase font-bold block">Carbos (g)</label>
                <input type="number" id="scanCarbInput" value="62" min="0" max="400" class="w-full bg-transparent text-center font-extrabold text-sm text-white focus:outline-none" />
              </div>
              <div class="bg-slate-950 p-2 rounded-lg border border-slate-800 text-center">
                <label for="scanFatInput" class="text-[10px] text-amber-400 uppercase font-bold block">Grasas (g)</label>
                <input type="number" id="scanFatInput" value="22" min="0" max="150" class="w-full bg-transparent text-center font-extrabold text-sm text-white focus:outline-none" />
              </div>
            </div>

            <!-- Detected Ingredients List -->
            <div id="scannedIngredientsList" class="text-xs text-slate-300 space-y-1 pt-1 border-t border-slate-800/80">
              <!-- Populated by JS -->
            </div>

            <button type="button" id="addScannedMealBtn" class="w-full py-2.5 rounded-xl bg-[#B6FF2B] hover:bg-[#a3eb1b] text-slate-950 font-extrabold text-xs sm:text-sm transition shadow-lg shadow-[#B6FF2B]/10">
              + Registrar Comida en Mi Día
            </button>
          </div>
        </div>

        <!-- Right 6 cols: Today's Logged Meals + Coach Feedback -->
        <div class="lg:col-span-6 glass-card rounded-2xl p-5 flex flex-col justify-between space-y-4">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div>
