      });

      // Knee pain slider
      document.getElementById('kneePainSlider').addEventListener('input', (e) => {
        const val = parseInt(e.target.value, 10);
        state.kneePain = val;
        const label = document.getElementById('kneePainValueLabel');
        const advice = document.getElementById('kneeClinicalAdvice');
        const pill = document.getElementById('kneeStatusPill');

        if (val <= 2) {
          label.textContent = `${val} / 10 (Óptima)`;
          label.className = 'font-bold text-emerald-400';
          advice.textContent = '✅ Verde (0-2/10): Puedes ejecutar la sesión planificada sin restricciones adicionales.';
          pill.textContent = '🦵 Rodilla Der. (Injerto LCA + Sutura Asa de Balde): Carga Controlada';
        } else if (val <= 4) {
          label.textContent = `${val} / 10 (Precaución Moderada)`;
          label.className = 'font-bold text-amber-400';
          advice.textContent = '⚠️ Amarillo (3-4/10): Sustituye hoy impacto (carrera/saltos) por Natación o Ciclismo Z2 suave e isométricos.';
          pill.textContent = '🦵 Rodilla Der.: Modo Descarga de Impacto Activo';
        } else {
          label.textContent = `${val} / 10 (Descarga Obligatoria)`;
          label.className = 'font-bold text-rose-400';
          advice.textContent = '🛑 Rojo (>=5/10): Suspende carga de impacto y flexión profunda hoy. Prioriza hielo/movilidad sin dolor y control fisioterapéutico.';
          pill.textContent = '🦵 Rodilla Der.: Alerta de Protección Articular';
        }
      });

      // Preset Meal Buttons
      document.querySelectorAll('.preset-meal-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const key = btn.getAttribute('data-preset');
          document.querySelectorAll('.preset-meal-btn').forEach(b => {
            b.className = 'preset-meal-btn px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 hover:text-white border border-slate-700 transition';
          });
          btn.className = 'preset-meal-btn px-2.5 py-1 rounded-lg text-xs font-semibold bg-[#B6FF2B]/20 text-[#B6FF2B] border border-[#B6FF2B]/40 transition';
          renderScannerPreset(key);
        });
      });

      // Photo file input upload (Real Camera/Gallery photo analysis simulation)
      document.getElementById('mealPhotoInput').addEventListener('change', (e) => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (ev) => {
          document.getElementById('scannerPreviewImg').src = ev.target.result;
          const cleanName = file.name.replace(/\.[^/.]+$/, '').replace(/[-_]/g, ' ');
          document.getElementById('scannedMealTitle').value = `Plato Escaneado (${cleanName})`;
          document.getElementById('scanConfidenceBadge').textContent = '✓ Foto Analizada por Cal AI · Ajusta gramos o porción si deseas';
          document.getElementById('scannerOverlays').innerHTML = `
            <div class="absolute top-3 left-3 bg-[#B6FF2B] text-slate-950 px-2.5 py-1 rounded-lg text-[11px] font-extrabold shadow-lg">
              📸 Imagen Personal Detectada · Estimando Densidad Calórica
            </div>
            <div class="absolute bottom-3 left-3 bg-slate-900/90 text-white border border-[#B6FF2B]/50 px-2.5 py-1 rounded-lg text-[11px] font-bold">
              Proteína + Carbohidratos Complejos + Vegetales
            </div>
          `;
          showToast('Fotografía analizada por Cal AI');
        };
        reader.readAsDataURL(file);
      });

      // Portion multiplier slider
      document.getElementById('portionMultiplierSlider').addEventListener('input', (e) => {
        state.portionMultiplier = parseFloat(e.target.value) || 1.0;
        updateScannerNumbersFromMultiplier();
      });

      // Manual macro inputs inside scanner
      ['scanProtInput', 'scanCarbInput', 'scanFatInput'].forEach(id => {
        document.getElementById(id).addEventListener('input', updateScannedTotalFromInputs);
      });

      // Add Scanned Meal to Today's Log
      document.getElementById('addScannedMealBtn').addEventListener('click', () => {
        const title = document.getElementById('scannedMealTitle').value.trim() || 'Comida Escaneada Cal AI';
        const prot = parseInt(document.getElementById('scanProtInput').value || '0', 10);
        const carb = parseInt(document.getElementById('scanCarbInput').value || '0', 10);
        const fat = parseInt(document.getElementById('scanFatInput').value || '0', 10);
        const kcal = prot * 4 + carb * 4 + fat * 9;

        const now = new Date();
        const timeStr = now.toLocaleTimeString('es-BO', { hour: '2-digit', minute: '2-digit' });

        if (!state.mealsByDay[state.currentDay]) state.mealsByDay[state.currentDay] = [];
        state.mealsByDay[state.currentDay].push({
          id: 'scan_' + Date.now(),
          time: timeStr,
          name: `📸 ${title}`,
          prot,
          carb,
          fat,
          kcal
        });

        renderDashboard();
        showToast(`¡Registrado! +${kcal} kcal añadidas al Día ${state.currentDay}`);
      });

      // Quick Food Adder
      document.getElementById('addQuickFoodBtn').addEventListener('click', () => {
        const name = document.getElementById('quickFoodName').value.trim() || 'Snack Híbrido';
        const prot = parseInt(document.getElementById('quickFoodProt').value || '15', 10);
        const carb = parseInt(document.getElementById('quickFoodCarb').value || '25', 10);
        const fat = parseInt(document.getElementById('quickFoodFat').value || '8', 10);
        const kcal = prot * 4 + carb * 4 + fat * 9;

        if (!state.mealsByDay[state.currentDay]) state.mealsByDay[state.currentDay] = [];
        state.mealsByDay[state.currentDay].push({
          id: 'quick_' + Date.now(),
          time: 'Extra',
          name,
          prot,
          carb,
          fat,
          kcal
        });

        document.getElementById('quickFoodName').value = '';
        document.getElementById('quickFoodProt').value = '';
        document.getElementById('quickFoodCarb').value = '';
        document.getElementById('quickFoodFat').value = '';

        renderDashboard();
        showToast(`Añadido: ${name} (${kcal} kcal)`);
      });

      // Reset day meals
      document.getElementById('resetDayMealsBtn').addEventListener('click', () => {
        initDefaultMeals();
        renderDashboard();
        showToast('Comidas de muestra restauradas');
      });

      // Week filter buttons
      document.querySelectorAll('.week-filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          state.selectedWeek = parseInt(btn.getAttribute('data-week'), 10);
          document.querySelectorAll('.week-filter-btn').forEach(b => {
            b.classList.remove('bg-[#B6FF2B]/15', 'border-[#B6FF2B]', 'text-white');
            b.classList.add('bg-slate-900/80', 'border-slate-800', 'text-slate-300');
          });
          btn.classList.remove('bg-slate-900/80', 'border-slate-800', 'text-slate-300');
          btn.classList.add('bg-[#B6FF2B]/15', 'border-[#B6FF2B]', 'text-white');
          renderTrainingGrid();
        });
      });

      // Discipline filter buttons
      document.querySelectorAll('.disc-filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          state.selectedDiscipline = btn.getAttribute('data-disc');
          document.querySelectorAll('.disc-filter-btn').forEach(b => {
            b.className = 'disc-filter-btn px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-900 text-slate-300 border border-slate-800';
          });
          btn.className = 'disc-filter-btn px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-200 text-slate-950';
          renderTrainingGrid();
        });
      });

      // RTS safety checklist
      document.querySelectorAll('.rts-check').forEach(chk => {
        chk.addEventListener('change', () => {
          const checked = document.querySelectorAll('.rts-check:checked').length;
          const badge = document.getElementById('rtsReadinessScore');
          if (checked === 4) {
            badge.textContent = '✓ Listo para Pliometría y Desniveles Controlados';
            badge.className = 'px-3 py-1 rounded-full text-xs font-extrabold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40';
          } else {
            badge.textContent = `Fase Actual: ${checked} de 4 Criterios Listos`;
            badge.className = 'px-3 py-1 rounded-full text-xs font-extrabold bg-amber-500/20 text-amber-300 border border-amber-500/40';
          }
        });
      });

      // Quiz Verification
      document.getElementById('checkQuizBtn').addEventListener('click', () => {
        const q1 = document.getElementById('quizQ1').value;
        const q2 = document.getElementById('quizQ2').value;
        const q3 = document.getElementById('quizQ3').value;
        let score = 0;
        if (q1 === 'pecho') score++;
        if (q2 === 'high') score++;
        if (q3 === 'pre') score++;

        const badge = document.getElementById('quizScoreBadge');
        const fb = document.getElementById('quizFeedbackText');
        badge.textContent = `${score} / 3 Correctas`;

        if (score === 3) {
          badge.className = 'text-xs font-bold px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40';
          fb.textContent = '🎉 ¡Excelente, Víctor! Dominas las reglas clave para proteger tu rodilla derecha y optimizar tu nutrición híbrida.';
          fb.className = 'text-xs text-emerald-400 font-semibold';
        } else {
          badge.className = 'text-xs font-bold px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/40';
          fb.textContent = `Acertaste ${score} de 3. Pista: modera la patada de pecho, pedalea a 80-90 RPM y toma el colágeno 45-60 min antes de entrenar.`;
          fb.className = 'text-xs text-amber-300';
        }
      });

      // Profile Modal Controls
      const modal = document.getElementById('profileModal');
      const openModal = () => {
        document.getElementById('inputWeight').value = state.profile.weightKg;
        document.getElementById('inputHeight').value = state.profile.heightCm;
        document.getElementById('inputGoal').value = String(state.profile.goalCalorieDelta);
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      };
      const closeModal = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      };

      document.getElementById('openProfileModalBtn').addEventListener('click', openModal);
      document.getElementById('closeProfileModalBtn').addEventListener('click', closeModal);
      document.getElementById('cancelProfileModalBtn').addEventListener('click', closeModal);

      document.getElementById('saveProfileModalBtn').addEventListener('click', () => {
        const w = parseFloat(document.getElementById('inputWeight').value) || 72;
        const h = parseFloat(document.getElementById('inputHeight').value) || 174;
        const g = parseInt(document.getElementById('inputGoal').value, 10) || 0;
        state.profile.weightKg = Math.min(140, Math.max(45, w));
        state.profile.heightCm = Math.min(215, Math.max(140, h));
        state.profile.goalCalorieDelta = g;
        state.waterTarget = +(state.profile.weightKg * 0.042).toFixed(1);
        document.getElementById('waterCountText').textContent = `${state.waterLiters.toFixed(2)} / ${state.waterTarget.toFixed(1)} L`;

        closeModal();
        renderDashboard();
        updateAnalyticsCharts();
        showToast('Parámetros biométricos y metas actualizados');
      });
    });
  </script>
</body>
</html>
