    // Calculate BMR (Mifflin-St Jeor) & Daily Targets for Current Day
    function calculateDailyTargets(dayNumber) {
      const p = state.profile;
      // BMR for male: 10*W + 6.25*H - 5*A + 5
      const tmb = Math.round(10 * p.weightKg + 6.25 * p.heightCm - 5 * p.age + 5);
      const neatFactor = 1.35; // Student/creator daily movement base
      const baseMaintenance = Math.round(tmb * neatFactor);

      const dayPlan = state.trainingPlan.find(item => item.day === dayNumber) || state.trainingPlan[0];
      const burned = dayPlan.completed ? dayPlan.kcalBurn : Math.round(dayPlan.kcalBurn * 0.5);

      const targetKcal = Math.round(baseMaintenance + burned + p.goalCalorieDelta);
      const targetProt = Math.round(p.weightKg * 2.2); // 2.2 g/kg
      const targetFat = Math.round(p.weightKg * 0.95); // ~0.95 g/kg
      const remainingKcalForCarbs = Math.max(400, targetKcal - (targetProt * 4 + targetFat * 9));
      const targetCarb = Math.round(remainingKcalForCarbs / 4);

      return {
        tmb,
        burned,
        targetKcal,
        targetProt,
        targetCarb,
        targetFat,
        dayPlan
      };
    }

    // Show toast notification
    let toastTimeout = null;
    function showToast(msg) {
      const toast = document.getElementById('toastNotification');
      const text = document.getElementById('toastMessage');
      text.textContent = msg;
      toast.classList.remove('hidden');
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.add('hidden');
      }, 3200);
    }

    // Render Cal AI Dashboard (Tab 1)
    function renderDashboard() {
      const day = state.currentDay;
      const targets = calculateDailyTargets(day);
      const meals = state.mealsByDay[day] || [];

      let consumedProt = 0;
      let consumedCarb = 0;
      let consumedFat = 0;
      let consumedKcal = 0;

      meals.forEach(m => {
        consumedProt += m.prot;
        consumedCarb += m.carb;
        consumedFat += m.fat;
        consumedKcal += m.kcal;
      });

      const remainingKcal = targets.targetKcal - consumedKcal;
      const ringEl = document.getElementById('mainCalorieRing');
      const circumference = 414.69;
      const ratio = Math.min(1, Math.max(0, consumedKcal / targets.targetKcal));
      ringEl.style.strokeDashoffset = (circumference * (1 - ratio)).toFixed(1);

      const remText = document.getElementById('caloriesRemainingText');
      const remLabel = document.getElementById('caloriesRemainingLabel');
      if (remainingKcal >= 0) {
        remText.textContent = remainingKcal.toLocaleString('es-BO');
        remLabel.textContent = 'kcal restantes';
        ringEl.setAttribute('stroke', '#B6FF2B');
      } else {
        remText.textContent = '+' + Math.abs(remainingKcal).toLocaleString('es-BO');
        remLabel.textContent = 'kcal sobre meta';
        ringEl.setAttribute('stroke', '#F59E0B');
      }

      document.getElementById('caloriesConsumedSub').textContent =
        `${consumedKcal.toLocaleString('es-BO')} / ${targets.targetKcal.toLocaleString('es-BO')} kcal`;

      document.getElementById('activeTrainingDayBadge').textContent =
        `Día ${day} · ${targets.dayPlan.discLabel}`;

      // Macros bars
      document.getElementById('proteinText').textContent = `${consumedProt}g / ${targets.targetProt}g`;
      document.getElementById('proteinBar').style.width = `${Math.min(100, Math.round((consumedProt / targets.targetProt) * 100))}%`;

      document.getElementById('carbsText').textContent = `${consumedCarb}g / ${targets.targetCarb}g`;
      document.getElementById('carbsBar').style.width = `${Math.min(100, Math.round((consumedCarb / targets.targetCarb) * 100))}%`;

      document.getElementById('fatsText').textContent = `${consumedFat}g / ${targets.targetFat}g`;
      document.getElementById('fatsBar').style.width = `${Math.min(100, Math.round((consumedFat / targets.targetFat) * 100))}%`;

      // Bottom stats
      document.getElementById('tmbStat').textContent = `${targets.tmb.toLocaleString('es-BO')} kcal`;
      document.getElementById('burnedStat').textContent = `+${targets.burned} kcal`;
      const goalDelta = state.profile.goalCalorieDelta;
