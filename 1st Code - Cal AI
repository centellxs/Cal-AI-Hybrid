      const prot = Math.round(preset.prot * mult);
      const carb = Math.round(preset.carb * mult);
      const fat = Math.round(preset.fat * mult);
      const kcal = prot * 4 + carb * 4 + fat * 9;
      const weight = Math.round(preset.baseWeightG * mult);

      document.getElementById('portionMultiplierLabel').textContent = `${mult.toFixed(1)}x (${weight}g aprox.)`;
      document.getElementById('scanProtInput').value = prot;
      document.getElementById('scanCarbInput').value = carb;
